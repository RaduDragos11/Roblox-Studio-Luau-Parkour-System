local remote = game.ReplicatedStorage.DropKick
UIS.InputBegan:Connect(function(input , gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.E and Stats.isInAir == true and Stats.isMantleing == false and Stats.isVaulting == false and Stats.isDropKicking == false then
		
		DropkickTrack:Play()
		remote:FireServer( Stats , Hrp.Position , Hrp.CFrame.LookVector,dropkickSound , character)
		task.wait(0.1)
		dropkickSwing:Play()
	end
        
end)
