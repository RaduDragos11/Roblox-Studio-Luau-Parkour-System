	end
end)


UIS.InputBegan:Connect(function(input , gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.Space and Stats.isMantleing == true then
        Stats.isMantleing = false
		Hrp.Anchored = false
		humanoid:ChangeState(Enum.HumanoidStateType.Landed)
		Hrp.AssemblyLinearVelocity =Hrp.CFrame.LookVector * 30 + Vector3.new(0,80,0)
		mantleTrack:Stop()
	end
end)
