-------------------------------------------------------------// Vaulting //-------------------------------------------------------------------------------------------------------------------------------------------

UIS.InputBegan:Connect(function(input,gpe)
	if gpe then return end
	if Stats.isVaultable == true and input.KeyCode == Enum.KeyCode.Space  then
		Stats.isVaulting = true
		Hrp.Anchored = true
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		--Hrp.CFrame = Hrp.CFrame * CFrame.new(0,0,-15)
		VaultTween:Play()
		valutingTrack:Play()
		valutingTrack:AdjustSpeed(1.44)
		vaultSound:Play()
		VaultTween.Completed:Connect(function()
			Hrp.Anchored = false
			humanoid:ChangeState(Enum.HumanoidStateType.Landed)
			Stats.isVaulting = false
		end)

		
	end
		
end)

